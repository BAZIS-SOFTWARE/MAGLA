@startuml
title Алгоритм решения уравнений Навье-Стокса \n(метод расщепления по давлению)
 
start
 
partition "Инициализация" {
  :u = u0 (начальная скорость);
  :p = P0;
  :T = T0;
}

 
partition "Цикл по временным шагам" {
  while (n ≤ N?) is (да)

  partition "Однократное формирование матриц" {
  :Матрица обратной массы: invM = M⁻¹;
    note right
Зависит от плотности и температуры - RHO(T).
  end note
  :Матрица вязкости: K;
      note right
Зависит от RHO(T) и T.
  end note
  :Матрица дивергенции: B;
        note right
Зависит от геометрии.
  end note
  :Матрица Лапласа: L;
        note right
Зависит от M.
  end note
}
    :**Шаг 1: конвективный член**  
    C(u) — локально по элементам;
    
    :**Шаг 2: формирование R**  
    R = -C*u - v*K*u + f;
    
    :**Шаг 3: предиктор скорости**  
    u* = u + Δt * invM * R;
    
    :**Шаг 4: дивергенция предиктора**  
    d = B * u*;
    
    :**Шаг 5: решение Пуассона**  
    L * p_new = d / Δt;
    
    :**Шаг 6: коррекция скорости**  
    u = u* - Δt * invM * Bᵀ * p_new;
    
    :**Шаг 7: обновление давления**  
    p = p_new;

    :**Шаг 8: расчет температуры газа**
    T = T_new;
            note right
По уравнению энергии.
  end note
    
    :n = n + 1;
  endwhile (нет)
}
 
:Вывод результатов;
stop
@enduml