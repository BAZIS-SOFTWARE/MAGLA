@startuml
start
 
:Начальные условия u=0 Fpl=0 k=0;
 
while (k < 100 и сходимость не достигнута?) is (да)
  :Формируем F_ext;
  note right
    Внешние нагрузки
  end note
  :Формируем F_int;
  note right
    температурные нагрузки,
    начальные упругие деформации,
    пластические деформации
  end note
      if (Обновить матрицу жесткости?) then (Да)
        :Сборка матрицы жесткости;
      endif
  :Решаем K*du = F_ext + Fpl;
  :Цикл по элементам;
    note right
    Вычисляем экв. напряжения Seq
  end note
       if (Seq > St) then (пластическое течение)
             if (k % n == 0) then (n - итерация сборки)
              :Обновить параметр жесткости материала;
            else
              :Пластическая коррекция;
                note right
                  Определяется новый девиатор,
                  вычисляютсяновые реальные напряжения
                end note
              :Запоминаем dEpl;
            endif
        endif

  :Проверка сходимости;
  note right
    По разности перемещений
  end note
  :k = k + 1;
endwhile (да)
 
:Конец;
stop
 
@enduml