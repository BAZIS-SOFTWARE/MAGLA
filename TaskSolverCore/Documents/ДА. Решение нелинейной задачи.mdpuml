@startuml
start
while (Достигнуто время окончания?) is (Нет)

  :запуск итератора;

  while (Есть еще итерации?) is (Да)

    :инициализировать вектора нагрузок и решения;
    :инициализировать матрицу жесткости;
    :вычислить материальные свойства элементов;
    :задать нагрузки;
    :задать ГУ;
    :провести расчет неизвестных;

    partition "**Смотри ДА для конкретной задачи**" {

    }

    :проверка сходимости;
    if (сходимость получена?) then (Да)
        :Задача сошлась; 
        break
    endif

    :модификация коэфф. жесткости материала
    или фиктивных нагрузок;

  endwhile (Нет)

  :увеличить время на шаг dt;

endwhile (Да)

:завершить работу;

stop
@enduml